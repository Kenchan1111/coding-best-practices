#!/usr/bin/env bash
# coding-best-practices uninstall - remove only links managed by skill/setup.
set -euo pipefail
umask 077

SKILL_NAME="coding-best-practices"
SOURCE_SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

HOST="auto"
DRY_RUN=0
YES=0
QUIET=0

usage() {
  cat <<'USAGE'
Usage: skill/uninstall [options]

Remove coding-best-practices skill links created by skill/setup.
Unmanaged files, directories, and symlinks are skipped.

Options:
  --host <auto|claude|codex|kimi|all>  Target host(s). Default: auto.
  --dry-run                      Print removals without changing files.
  --yes, --force                 Do not prompt before removing managed links.
  -q, --quiet                    Reduce output.
  -h, --help                     Show this help.
USAGE
}

log() {
  if [ "$QUIET" -eq 0 ]; then
    printf '%s\n' "$*"
  fi
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host)
      [ $# -lt 2 ] && die "missing value for --host"
      HOST="$2"
      shift 2
      ;;
    --host=*)
      HOST="${1#--host=}"
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --yes|--force|-y)
      YES=1
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

case "$HOST" in
  auto|claude|codex|kimi|all) ;;
  *) die "unknown --host value: $HOST" ;;
esac

[ -n "${HOME:-}" ] || die "\$HOME is not set"

want_claude=0
want_codex=0
want_kimi=0
case "$HOST" in
  claude)
    want_claude=1
    ;;
  codex)
    want_codex=1
    ;;
  kimi)
    want_kimi=1
    ;;
  all)
    want_claude=1
    want_codex=1
    want_kimi=1
    ;;
  auto)
    if [ -e "$HOME/.claude/skills/$SKILL_NAME" ] || [ -L "$HOME/.claude/skills/$SKILL_NAME" ]; then
      want_claude=1
    fi
    if [ -e "$HOME/.codex/skills/$SKILL_NAME" ] || [ -L "$HOME/.codex/skills/$SKILL_NAME" ]; then
      want_codex=1
    fi
    if [ -e "$HOME/.kimi/skills/$SKILL_NAME" ] || [ -L "$HOME/.kimi/skills/$SKILL_NAME" ]; then
      want_kimi=1
    fi
    ;;
esac

resolve_link_target() {
  local link_path="$1"
  local raw_target
  raw_target="$(readlink "$link_path")" || return 1
  case "$raw_target" in
    /*) ;;
    *) raw_target="$(dirname "$link_path")/$raw_target" ;;
  esac
  if [ -e "$raw_target" ]; then
    (cd "$raw_target" && pwd -P)
  else
    (cd "$(dirname "$raw_target")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$raw_target")")
  fi
}

is_managed_link() {
  local target="$1"
  [ -L "$target" ] || return 1
  [ "$(resolve_link_target "$target")" = "$SOURCE_SKILL_DIR" ]
}

collect_target() {
  local label="$1"
  local target="$2"
  if is_managed_link "$target"; then
    REMOVALS="${REMOVALS}${label}:${target}"$'\n'
  elif [ -e "$target" ] || [ -L "$target" ]; then
    log "Skipping unmanaged $label target: $target"
  fi
}

REMOVALS=""
if [ "$want_claude" -eq 1 ]; then
  collect_target "claude" "$HOME/.claude/skills/$SKILL_NAME"
fi
if [ "$want_codex" -eq 1 ]; then
  collect_target "codex" "$HOME/.codex/skills/$SKILL_NAME"
fi
if [ "$want_kimi" -eq 1 ]; then
  collect_target "kimi" "$HOME/.kimi/skills/$SKILL_NAME"
fi

if [ -z "$REMOVALS" ]; then
  log "Nothing to remove."
  exit 0
fi

log "Managed links to remove:"
printf '%s' "$REMOVALS" | while IFS=: read -r label target; do
  [ -n "$target" ] || continue
  log "  $label: $target"
done

if [ "$DRY_RUN" -eq 0 ] && [ "$YES" -eq 0 ]; then
  if [ -t 0 ]; then
    printf 'Remove these managed links? [y/N] '
    read -r reply
    case "$reply" in
      y|Y|yes|YES) ;;
      *) log "Aborted."; exit 0 ;;
    esac
  else
    die "non-interactive uninstall requires --yes or --force"
  fi
fi

printf '%s' "$REMOVALS" | while IFS=: read -r label target; do
  [ -n "$target" ] || continue
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY-RUN: rm -f $target"
  else
    rm -f "$target"
    log "Removed $label: $target"
  fi
done

log "$SKILL_NAME uninstall complete."
